      "timeout_ms": "200",
      "memory_limit_mib": "64",
      "log_level": "info",
      "region": "eu-1",
      "owner": "platform"
    },
    "current": {
      "batch_size": "16",
      "timeout_ms": "10",
      "memory_limit_mib": "8",
      "log_level": "debug",
      "region": "eu-2",
      "owner": "ml"
    }
  },
  "timeline": [
    { "at": "T-30m", "event": "Config rollout started" },
    { "at": "T-12m", "event": "p99 alert fired" },
    { "at": "T-0", "event": "Rollout paused by on-call" }
  ]
